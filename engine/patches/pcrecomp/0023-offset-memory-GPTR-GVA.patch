-    if (ppv) *ppv = (uint32_t)(uintptr_t)bits;   /* the guest draws straight into this */
+    if (ppv) *ppv = GVA(bits);   /* the guest draws straight into this */
     RET(g_next_handle++, 6);
 }
 
