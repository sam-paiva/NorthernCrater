index 053b82d..b054587 100644
--- a/runtime/recomp32/recomp_types.h
+++ b/runtime/recomp32/recomp_types.h
@@ -192,6 +192,22 @@ extern ptrdiff_t g_mem_base;
 #define ADDR(va)     ((uintptr_t)(uint32_t)(va) + g_mem_base)
 #endif
 
+/* Guest addresses and host pointers, both ways, for the runtime and the HLE. Flat: the same
+ * number. Offset (a host that can't map the low 4 GB, such as an Apple arm64 process): guest
+ * memory is a 4 GB arena at g_mem_base and a guest address is an offset into it.
+ *   GPTR(va)       the host pointer for a guest address (0 stays NULL)
+ *   GVA(p)         the guest address of a host pointer into guest memory (NULL stays 0)
+ *   IS_GUEST(p)    whether a host pointer lies in guest memory */
+#ifdef RECOMP_FLAT_MEMORY
+#define GPTR(va)     ((void *)(uintptr_t)(uint32_t)(va))
+#define GVA(p)       ((uint32_t)(uintptr_t)(p))
+#define IS_GUEST(p)  ((uintptr_t)(p) <= 0xFFFFFFFFu)
+#else
+#define GPTR(va)     ((uint32_t)(va) ? (void *)((uintptr_t)(uint32_t)(va) + (uintptr_t)g_mem_base) : (void *)0)
+#define GVA(p)       ((p) ? (uint32_t)((uintptr_t)(p) - (uintptr_t)g_mem_base) : 0u)
+#define IS_GUEST(p)  ((uintptr_t)(p) - (uintptr_t)g_mem_base <= 0xFFFFFFFFu)
+#endif
+
 /* Thread-relative segment bases. In Win32, fs: points at the TIB/TEB; gs is
  * unused on x86. The lifter emits fs:/gs: accesses as FS_BASE/GS_BASE + addr,
  * so the runtime points g_fs_base at a simulated TIB (VA). cs/ds/es/ss are flat. */
